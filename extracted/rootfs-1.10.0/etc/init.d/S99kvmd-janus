#!/bin/sh

DAEMON="/usr/bin/kvmd-janus"
DAEMON_ARGS="--run"
PIDFILE="/var/run/kvmd-janus.pid"

# Note: the TURN REST API (http://127.0.0.1:8081/turnserver.json) is now served directly by nginx
# (see the 8081 server block in etc/kvmd/nginx-kvmd.conf); a standalone Python process is no longer needed.

start() {
    printf "Starting kvmd-janus: "
    start-stop-daemon --start --quiet --background --make-pidfile --pidfile $PIDFILE --exec /bin/sh -- -c "exec $DAEMON $DAEMON_ARGS 2>&1 | logger -t kvmd-janus -p daemon.info"
    [ $? = 0 ] && echo "OK" || echo "FAIL"
}

stop() {
    printf "Stopping kvmd-janus: "
    start-stop-daemon --stop --quiet --pidfile $PIDFILE
    [ $? = 0 ] && echo "OK" || echo "FAIL"
}

status() {
    printf "kvmd-janus status: "
    if [ -f $PIDFILE ]; then
        PID=$(cat $PIDFILE)
        if [ -d /proc/$PID ]; then
            echo "Running (PID: $PID)"
            return 0
        else
            echo "Stopped (PID file exists but process does not)"
            return 1
        fi
    else
        echo "Stopped (PID file does not exist)"
        return 2
    fi
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart|reload)
        stop
        start
        ;;
    status)
        status
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
esac

exit $?
