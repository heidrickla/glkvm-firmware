#!/bin/sh

DAEMON="/usr/bin/kvmd-media"
DAEMON_ARGS="--run --unix /run/kvmd/media.sock --unix-rm 1 --unix-mode 0660 --heartbeat 15 --h264-sink kvmd::ustreamer::h264 --h264-wait-timeout 1"
PIDFILE="/var/run/kvmd-media.pid"

. /etc/profile

start() {
    printf "Starting kvmd-media: "
    start-stop-daemon --start --quiet --background --make-pidfile --pidfile $PIDFILE --exec /bin/sh -- -c "exec $DAEMON $DAEMON_ARGS 2>&1 | logger -t kvmd-media -p daemon.debug"
    [ $? = 0 ] && echo "OK" || echo "FAIL"
}

stop() {
    printf "Stopping kvmd-media: "

    PIDS=$(pgrep -f '[k]vmd-media')
    if [ -n "$PIDS" ]; then
        kill $PIDS 2>/dev/null || true
    fi

    start-stop-daemon --stop --quiet --pidfile $PIDFILE 2>/dev/null || true
    rm -f $PIDFILE

    if pgrep -f '[k]vmd-media' >/dev/null; then
        echo "FAIL"
    else
        echo "OK"
    fi
}

status() {
    printf "kvmd-media status: "
    if [ -f $PIDFILE ]; then
        PID=$(cat $PIDFILE)
        if kill -0 $PID 2>/dev/null; then
            echo "running (pid: $PID)"
            return 0
        else
            echo "stopped (stale pid file)"
            return 1
        fi
    else
        echo "stopped"
        return 3
    fi
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart|reload)
        stop
        start
        ;;
    status)
        status
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
esac

exit $?
