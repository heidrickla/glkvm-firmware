#!/bin/sh

DAEMON="/usr/bin/netbird"
CONFIG_DIR="/etc/kvmd/user/netbird"
CONFIG_FILE="$CONFIG_DIR.json"
LOG_DIR="/var/log/netbird"
PIDFILE="/var/run/netbird.pid"
DATA_DIR="/var/lib/netbird"

start() {
    printf 'Starting netbird: '
    [ -d "$DATA_DIR" ] || mkdir -p "$DATA_DIR"
    [ -d "$LOG_DIR" ] || mkdir -p "$LOG_DIR"

    if [ ! -e "$CONFIG_DIR" ]; then
        mkdir -p "$CONFIG_DIR"
    fi

    if [ ! -L "$DATA_DIR" ]; then
        rm -rf "$DATA_DIR"
        ln -s "$CONFIG_DIR" "$DATA_DIR"
    fi

    # Check if config file exists, if not then don't start
    if [ ! -f "$CONFIG_FILE" ]; then
        echo "DISABLED (config file not found)"
        return 0
    fi

    # Use jq to properly parse JSON config file
    if [ -x "$(command -v jq)" ]; then
        # Parse JSON file using jq
        ENABLED=$(jq -r '.enable // false' "$CONFIG_FILE")
        if [ "$ENABLED" != "true" ]; then
            echo "DISABLED"
            return 0
        fi
    else
        # If jq is not available, fall back to basic parsing
        ENABLED=$(grep -o '"enable"[[:space:]]*:[[:space:]]*true' "$CONFIG_FILE" | wc -l)
        if [ "$ENABLED" -eq 0 ]; then
            echo "DISABLED"
            return 0
        fi
    fi

    start-stop-daemon -S -b -m -p $PIDFILE -x $DAEMON -- service run --log-level info --daemon-addr unix:///var/run/netbird.sock --log-file $LOG_DIR/client.log
    if [ $? = 0 ]; then
        echo "OK"
        # Set netbird configuration after successful start
        # Check and add ip_forward settings if not already present
        if [ ! -n "$(grep '^net\.ipv4\.ip_forward' /etc/sysctl.conf)" ]; then
            echo 'net.ipv4.ip_forward = 1' >> /etc/sysctl.conf
        fi
        if [ ! -n "$(grep '^net\.ipv6\.conf\.all\.forwarding' /etc/sysctl.conf)" ]; then
            echo 'net.ipv6.conf.all.forwarding = 1' >> /etc/sysctl.conf
        fi
        # Allow accepting RA even when forwarding is enabled (to get IPv6 address via SLAAC)
        if [ ! -n "$(grep '^net\.ipv6\.conf\.all\.accept_ra' /etc/sysctl.conf)" ]; then
            echo 'net.ipv6.conf.all.accept_ra = 2' >> /etc/sysctl.conf
        fi
        sysctl -p /etc/sysctl.conf
    else
        echo "FAIL"
    fi
}

stop() {
    printf 'Stopping netbird: '
    start-stop-daemon -K -p $PIDFILE --retry TERM/1/KILL/1
    RET=$?
    rm -f $PIDFILE
    [ $RET = 0 ] && echo "OK" || echo "FAIL"
}

restart() {
    stop
    sleep 1
    start
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart|reload)
        restart
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
esac

exit $?
