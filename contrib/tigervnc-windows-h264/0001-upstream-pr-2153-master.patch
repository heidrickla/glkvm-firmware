From 342ce80343e59d2cec4860bd2f219db737b3b001 Mon Sep 17 00:00:00 2001
From: heidrickla <lewis.heidrick@gmail.com>
Date: Tue, 1 Sep 2026 22:44:57 -0500
Subject: [PATCH 1/2] Size the Windows H.264 decoded buffer for the actual
 stream

H264WinDecoderContext allocated decoded_buffer once, in the constructor,
from the decoder's output stream info before any input had been seen,
when its output type still had the default 1920x1080 frame size. That
is enough for 1080p streams and nothing larger: with a 2560x1440 stream
every ProcessOutput() returned E_FAIL, the drain loop had no case for
that result, and the viewer showed a black window while updates kept
arriving.

Re-size the buffer when the decoder reports a stream change, replace
the converter's output buffer on a stream change instead of adding a
second one, and stop retrying ProcessOutput() on an unexpected result.

Verified with a replayed 2560x1440 High 5.0 stream (black before,
renders after) and live 2560x1440@60 and 3840x2160@30 sessions against
kvmd-vnc.
---
 common/rfb/H264WinDecoderContext.cxx | 30 ++++++++++++++++++++++++++++
 1 file changed, 30 insertions(+)

diff --git a/common/rfb/H264WinDecoderContext.cxx b/common/rfb/H264WinDecoderContext.cxx
index ecfb4e56..7314b830 100644
--- a/common/rfb/H264WinDecoderContext.cxx
+++ b/common/rfb/H264WinDecoderContext.cxx
@@ -274,6 +274,9 @@ void H264WinDecoderContext::decode(const uint8_t* h264_buffer,
         MFT_OUTPUT_STREAM_INFO info;
         converter->GetOutputStreamInfo(0, &info);
 
+        // Replace, not add, in case this is not the first stream change
+        converted_sample->RemoveAllBuffers();
+        SAFE_RELEASE(converted_buffer)
         if (FAILED(MFCreateMemoryBuffer(info.cbSize, &converted_buffer)))
         {
           // Silently ignore errors, hoping its a temporary encoding glitch
@@ -284,6 +287,33 @@ void H264WinDecoderContext::decode(const uint8_t* h264_buffer,
         }
       }
       output_type->Release();
+
+      // The constructor sized decoded_buffer from the output stream info
+      // before any input had been seen, when the decoder's output type
+      // still had its default 1920x1080 frame size. A larger stream needs
+      // a larger buffer, or every ProcessOutput() fails.
+      MFT_OUTPUT_STREAM_INFO decoder_info;
+      if (SUCCEEDED(decoder->GetOutputStreamInfo(0, &decoder_info)))
+      {
+        DWORD maxlen = 0;
+        decoded_buffer->GetMaxLength(&maxlen);
+        if (decoder_info.cbSize > maxlen)
+        {
+          IMFMediaBuffer* buffer;
+          if (SUCCEEDED(MFCreateMemoryBuffer(decoder_info.cbSize, &buffer)))
+          {
+            decoded_sample->RemoveAllBuffers();
+            decoded_buffer->Release();
+            decoded_buffer = buffer;
+            decoded_sample->AddBuffer(decoded_buffer);
+          }
+        }
+      }
+    }
+    else
+    {
+      // Retrying won't help, and would loop forever
+      break;
     }
   }
 
-- 
