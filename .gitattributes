# Shell scripts and device init scripts MUST keep LF line endings.
#
# A CRLF shebang makes the interpreter unfindable on the device — busybox
# reports "cannot execute: required file not found", which reads like a missing
# binary rather than a line-ending problem. Hit for real on 2026-09-01 while
# deploying S99kvmd-vnc from Windows.
*.sh          text eol=lf
S99kvmd-*     text eol=lf
*.yaml        text eol=lf
*.yml         text eol=lf
*.md          text eol=lf
*.py          text eol=lf
*.example     text eol=lf
*.awk         text eol=lf

# Firmware and filesystem images are binary.
*.img         binary
*.squashfs    binary

# tools/publish-github.sh reads these line by line; a CR would ride along.
tools/publish/*.txt text eol=lf
